{
  "name": "vimag-media-manager-web",
  "version": "1.1.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "format": "prettier --write src tests *.json *.ts"
  },
  "dependencies": {
    "lucide-vue-next": "0.548.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "16.5.0",
    "jsdom": "27.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.1.3"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "glob": "14.0.2"
  }
}
